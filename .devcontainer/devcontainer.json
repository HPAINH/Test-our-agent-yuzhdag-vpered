{
  "name": "elbrus-news-insights",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Пульс бизнеса",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pip install --user uv && ~/.local/bin/uv sync && cd ui && npm ci && npm run build",
  "postStartCommand": "setsid nohup .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 > /tmp/app.log 2>&1 < /dev/null &",
  "secrets": {
    "LLM_API_KEY": {
      "description": "Общий ключ организаторов к моделям (необязательно: без него работает mock-режим)"
    },
    "LLM_BASE_URL": {
      "description": "OpenAI-совместимый адрес API организаторов"
    }
  },
  "containerEnv": {
    "RSS_ENABLED": "true",
    "NEWS_REFRESH_MIN": "30"
  }
}
