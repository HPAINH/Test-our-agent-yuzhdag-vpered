# Режим моделей: mock (детерминированный, без ключа) или live (общий ключ организаторов)
LLM_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_DAILY_BUDGET_RUB=500

# Данные: по умолчанию синтетические. Реальные данные кейса положите в ./data (в Git не попадают)
# DATA_DIR=/srv/data
# ALFA_DIR=/srv/data/alfa
# NEWS_DIR=/srv/data/news
RSS_ENABLED=false

SESSION_SECRET=change-me
FEED_THRESHOLD=0.35
AGENT_TOP_N=5
