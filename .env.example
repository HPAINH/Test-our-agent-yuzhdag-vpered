# Модели: без LLM_BASE_URL и LLM_API_KEY сервис не анализирует новости (LLM_MODE=stub — только для автотестов)
LLM_MODE=live
LLM_BASE_URL=
LLM_API_KEY=
LLM_DAILY_BUDGET_RUB=500

# Данные: по умолчанию синтетические. Реальные данные кейса положите в ./data (в Git не попадают)
# DATA_DIR=/srv/data
# ALFA_DIR=/srv/data/alfa
# NEWS_DIR=/srv/data/news
RSS_ENABLED=false
# Обновление новостей внутри приложения, минут (0 — выключено; в Codespaces и Docker — 30)
NEWS_REFRESH_MIN=0

SESSION_SECRET=change-me
FEED_THRESHOLD=0.35
AGENT_TOP_N=5

# Вход из интернет-банка: общий секрет подписи ссылок, демо-хост и разрешённые родители iframe
HOST_LAUNCH_SECRET=change-me-host
HOST_DEMO=true
EMBED_ALLOWED_ORIGINS='self'
