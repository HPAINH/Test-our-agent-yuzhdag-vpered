    "/api/v1/feed": {
      "get": {
        "summary": "Feed",
        "operationId": "feed_api_v1_feed_get",
        "parameters": [
          {
            "name": "hidden",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(exclude|only|include)$",
              "default": "exclude",
              "title": "Hidden"
            }
          },
          {
            "name": "factor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
